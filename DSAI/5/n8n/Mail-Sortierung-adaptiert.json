              "value": "={{ $('Mail-Felder extrahieren').item.json.inhalt }}"
            },
            {
              "id": "b5",
              "name": "prioritaet",
              "type": "number",
              "value": "={{ Math.min(5, Math.max(1, Math.round(Number($json.output.prioritaet) || 3))) }}"
            },
            {
              "id": "b6",
              "name": "dringlichkeit",
              "type": "string",
