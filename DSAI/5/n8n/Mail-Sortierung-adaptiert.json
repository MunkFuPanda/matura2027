    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"prioritaet\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5,\n      \"description\": \"5 sofort Aktion nötig, Schaden oder Frist drohen; 4 Antwort/Aktion heute erwartet; 3 normal, in den nächsten Tagen; 2 nur zur Kenntnis; 1 Werbung/automatisch, kann ungelesen bleiben\"\n    },\n    \"dringlichkeit\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"sofort\",\n        \"heute\",\n        \"diese Woche\",\n        \"nebenbei\"\n      ]\n    },\n    \"aktion\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"antworten\",\n        \"erledigen\",\n        \"bezahlen\",\n        \"lesen\",\n        \"keine\"\n      ]\n    },\n    \"grund\": {\n      \"type\": \"string\",\n      \"description\": \"Ein kurzer deutscher Satz\"\n    }\n  },\n  \"required\": [\n    \"prioritaet\",\n    \"dringlichkeit\",\n    \"aktion\",\n    \"grund\"\n  ]\n}"
      },
      "name": "Bewertung-Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
