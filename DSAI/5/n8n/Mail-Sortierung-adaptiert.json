    {
      "parameters": {
        "inputText": "=Von: {{ $json.absender }}\nBetreff: {{ $json.betreff }}\n\n{{ $json.inhalt }}",
        "categories": {
          "categories": [
            {
              "category": "Dringend",
              "description": "Zeitkritische Mails, die sofort Aufmerksamkeit brauchen: Deadlines, Ausfälle, Mahnungen, Terminänderungen, Antwort erwartet heute. Schlüsselwörter: dringend, urgent, ASAP, Frist, heute."
            },
            {
              "category": "Uni/Arbeit",
              "description": "Mails zu Arbeit, Uni, Schule, Projekten, Kollegen, Meetings, Kursen und Abgaben (z.B. RDI, n8n Academy)."
            },
            {
              "category": "Rechnung",
              "description": "Rechnungen, Zahlungsbestätigungen, Bestellungen, Abos, Versandbenachrichtigungen, Bank und Versicherung."
            },
            {
              "category": "Newsletter",
              "description": "Newsletter, Werbung, Rabattaktionen, Produkt-Updates, Marketing, automatisierte Massenmails."
            },
            {
              "category": "Sonstiges",
              "description": "Alles, was in keine andere Kategorie passt."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Ordne die Mail des Users genau einer dieser Kategorien zu: {categories}. Antworte nur im vorgegebenen JSON-Format, ohne Erklärung."
        }
      },
