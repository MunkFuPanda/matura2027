    {
      "parameters": {
        "promptType": "define",
        "text": "=Bewerte diese E-Mail nach Handlungsbedarf und Frist.\n\nVon: {{ $json.absender }}\nBetreff: {{ $json.betreff }}\n\n{{ $json.inhalt }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Du bewertest eingehende E-Mails für einen Postfachbesitzer. Maßgeblich sind nur Handlungsbedarf und Frist, nicht Absender oder Tonfall. Werbung und automatische Newsletter sind prioritaet 1. Antworte ausschließlich im vorgegebenen JSON-Format."
            }
          ]
        },
        "batching": {}
      },
      "name": "Wichtigkeit bewerten",
