<Window x:Class="MosaikWerkstatt.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eingabe" Height="150" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6"/>
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="70" IsDefault="True" Click="OnOk_Click" Margin="0,0,6,0"/>
            <Button Content="Abbrechen" Width="70" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
