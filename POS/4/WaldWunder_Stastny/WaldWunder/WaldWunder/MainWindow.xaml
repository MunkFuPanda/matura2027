<Window x:Class="WaldWunder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaldWunder Manager" Height="650" Width="1000" MinWidth="800" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="➕ Neues Waldwunder" Click="AddButton_Click" Margin="5"/>
            <Separator Margin="10,0"/>
            <Label Content="Suche:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSearch" Width="150" Margin="5" VerticalContentAlignment="Center"/>
            <Button Content="🔍 Stichwort" Click="SearchKeyword_Click" Margin="2"/>
            <Button Content="📍 Ort (±0.5)" Click="SearchLocation_Click" Margin="2"/>
        </ToolBar>

        <Grid Grid.Row="1" x:Name="MainContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Liste:" DockPanel.Dock="Top" FontWeight="Bold"/>
                <Button Content="Details anzeigen" DockPanel.Dock="Bottom" Click="ShowDetails_Click"  Margin="0,10,0,0"/>
                <ListBox x:Name="WaldwunderListBox" DisplayMemberPath="Name" Margin="0,5,0,0"/>
            </DockPanel>

            <Grid Grid.Column="1" Margin="10">
                <Image Source="/Model/Map.png" Stretch="Fill"/>

                <Canvas x:Name="MapCanvas"/>
            </Grid>
        </Grid>

        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="#AA000000" Grid.RowSpan="2">
            <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                <StackPanel>
                    <TextBlock Text="Neues Waldwunder" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Label Content="Name:"/>
                    <TextBox x:Name="InputName"/>

                    <Label Content="Beschreibung:"/>
                    <TextBox x:Name="InputDescription" Height="60" TextWrapping="Wrap"/>

                    <UniformGrid Columns="2" Margin="0,5">
                        <StackPanel Margin="0,0,5,0">
                            <Label Content="Lat:"/>
                            <TextBox x:Name="InputLat" Text="48.0"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <Label Content="Lon:"/>
                            <TextBox x:Name="InputLon" Text="16.0"/>
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="📁 Bilder wählen" Click="SelectImages_Click" Margin="0,10,0,5"/>
                    <ListBox x:Name="SelectedImagesListBox" Height="80"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Abbrechen" Click="HideDialog_Click" Margin="5" Width="80"/>
                        <Button Content="Registrieren" Click="Register_Click" Margin="5" Width="100" Background="LightGreen"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>