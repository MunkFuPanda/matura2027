<Window x:Class="Roboter_4C_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Roboter_4C_2026"
        xmlns:robot="clr-namespace:AbcRobotCore;assembly=RobotLibrary"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Row="1" Grid.Column="0" x:Name="Input" AcceptsReturn="True"></TextBox>
        <Button Grid.Row="0" Grid.Column="0" Click="Button_Click">Run</Button>
        <Label Grid.Column="1" Grid.Row="0">Tokens</Label>
        <ListBox Grid.Row="1" Grid.Column="1" Name="TokensListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="80" Text="{Binding Type}" Margin="5"/>
                        <TextBlock Text="{Binding Value}" Margin="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Column="2">Roboter</TextBlock>
        <robot:RobotField Grid.Column="2" Grid.Row="1" Name="RobotFieldControl"></robot:RobotField>
    </Grid>
</Window>
