<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:testwpf">


    <Style TargetType="{x:Type local:CustomControl1}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CustomControl1}">
                    <Border Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Image Source="pack://application:,,,/testwpf;component/Ressourcen/blobid1.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="300"/>
                            <Image Source="pack://application:,,,/testwpf;component/Ressourcen/blobid2.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="210" Height="210" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Image.RenderTransform>
                            </Image>
                            <TextBlock x:Name="minText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-100, 180, 0, 0" FontSize="16" Text="{Binding MinimumValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="-45"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="curText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 100, 0, 0" FontSize="16" Text="{Binding CurrentValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}"/>
                            <TextBlock x:Name="maxText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100, 180, 0, 0" FontSize="16" Text="{Binding MaximumValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
