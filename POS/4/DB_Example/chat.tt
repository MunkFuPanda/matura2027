<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".txt" #>

<#@ output extension=".generated.cs" #>
<#@ include file="$(LinqToDBT4SQLiteTemplatesPath)LinqToDB.SQLite.ttinclude" once="true" #>
<#@ include file="$(LinqToDBT4TemplatesPath)PluralizationService.ttinclude"  once="true" #>

<#
    NamespaceName        = "DataModels";
    GenerateSchemaAsType = true;

    // Resolve project root dynamically
    var projectDir = System.IO.Path.GetDirectoryName(Host.TemplateFile);

    // SQLite file in project root
    var dbPath = System.IO.Path.Combine(projectDir, "chatdb.db");

    // Load metadata using connection string (preferred)
    LoadSQLiteMetadata($"Data Source={dbPath};");

    GenerateModel();
#>



