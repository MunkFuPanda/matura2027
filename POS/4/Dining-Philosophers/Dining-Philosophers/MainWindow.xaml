<Window x:Class="Dining_Philosophers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dining_Philosophers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="startButton" Click="buttonStart" Content="Start" HorizontalAlignment="Left" Margin="50,380,0,0" VerticalAlignment="Top"/>
        <Button x:Name="endButton" Click="buttonEnd" Content="Stop" HorizontalAlignment="Left" Margin="700,380,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="80,60,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="100"/>
        <TextBox HorizontalAlignment="Left" Margin="80,100,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="100"/>
        <TextBox HorizontalAlignment="Left" Margin="80,140,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="100"/>
        <TextBox HorizontalAlignment="Left" Margin="80,180,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="100"/>
        <TextBox HorizontalAlignment="Left" Margin="80,220,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="100"/>

        <Label HorizontalAlignment="Left" Margin="200,30,0,0" Content="Zeit in ms" VerticalAlignment="Top"/>
        <TextBox x:Name="thinkingTime" Text="" HorizontalAlignment="Left" Margin="200,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50"/>
        <TextBox x:Name="thinkingVariance" Text="" HorizontalAlignment="Left" Margin="200,100,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="50"/>
        <TextBox x:Name="eatingTime" Text="" HorizontalAlignment="Left" Margin="200,140,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="50"/>
        <TextBox x:Name="eatingVariance" Text="" HorizontalAlignment="Left" Margin="200,180,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="50"/>
        <TextBox x:Name="pickUpTime" Text="" HorizontalAlignment="Left" Margin="200,220,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="50"/>

        <TextBox x:Name="status1" IsEnabled="False" HorizontalAlignment="Left" Margin="500,60 ,0,0" Text="nicht gestartet" VerticalAlignment="Top"/>
        <TextBox x:Name="status2" IsEnabled="False" HorizontalAlignment="Left" Margin="500,100,0,0" Text="nicht gestartet" VerticalAlignment="Top"/>
        <TextBox x:Name="status3" IsEnabled="False" HorizontalAlignment="Left" Margin="500,140,0,0" Text="nicht gestartet" VerticalAlignment="Top"/>
        <TextBox x:Name="status4" IsEnabled="False" HorizontalAlignment="Left" Margin="500,180,0,0" Text="nicht gestartet" VerticalAlignment="Top"/>
        <TextBox x:Name="status5" IsEnabled="False" HorizontalAlignment="Left" Margin="500,220,0,0" Text="nicht gestartet" VerticalAlignment="Top"/>

        <Label HorizontalAlignment="Left" Margin="300,60,0,0" Content="Denkzeit" VerticalAlignment="Top"/>
        <Label HorizontalAlignment="Left" Margin="300,100,0,0" Content="Varianz Denkzeit" VerticalAlignment="Top"/>
        <Label HorizontalAlignment="Left" Margin="300,140,0,0" Content="Esszeit" VerticalAlignment="Top"/>
        <Label HorizontalAlignment="Left" Margin="300,180,0,0" Content="Varianz Esszeit" VerticalAlignment="Top"/>
        <Label HorizontalAlignment="Left" Margin="300,220,0,0" Content="Aufheben Zeit" VerticalAlignment="Top"/>
    </Grid>
</Window>
