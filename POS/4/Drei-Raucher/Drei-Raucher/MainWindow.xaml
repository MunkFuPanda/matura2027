<Window x:Class="Drei_Raucher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Drei_Raucher"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Raucher A" Grid.Row="0"></Label>
        <Label Content="Raucher B" Grid.Row="1"></Label>
        <Label Content="Raucher C" Grid.Row="2"></Label>

        <TextBox x:Name="statusA" Text="nicht gestartet" Grid.Row="0" Grid.Column="1" IsReadOnly="True"></TextBox>
        <TextBox x:Name="statusB" Text="nicht gestartet" Grid.Row="1" Grid.Column="1" IsReadOnly="True"></TextBox>
        <TextBox x:Name="statusC" Text="nicht gestartet" Grid.Row="2" Grid.Column="1" IsReadOnly="True"></TextBox>

        <TextBox x:Name="takenA" Grid.Row="0" Grid.Column="3" IsReadOnly="True"></TextBox>
        <TextBox x:Name="takenB" Grid.Row="1" Grid.Column="3" IsReadOnly="True"></TextBox>
        <TextBox x:Name="takenC" Grid.Row="2" Grid.Column="3" IsReadOnly="True"></TextBox>

        <Label Grid.Row="0" Grid.Column="2" Content="Tabak"></Label>
        <Label Grid.Row="1" Grid.Column="2" Content="Papier"></Label>
        <Label Grid.Row="2" Grid.Column="2" Content="Streichholz"></Label>

        <TextBox x:Name="timeToSmoke"  Grid.Row="3" Grid.Column="1"></TextBox>

        <Button Click="startSmoking" x:Name="start" Grid.Row="4" Content="Start"></Button>
        <Button Click="endSmoking" x:Name="stop" Grid.Row="4" Grid.Column="2" Content="Stop"></Button>
    </Grid>
</Window>
