<Window x:Class="WPF_Formen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Formen"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas>
        <local:Basis X1="50" Y1="34" Stroke="Blue"></local:Basis>
        <local:Rechteck X1="100" Y1="44" X2="150" Y2="60" Stroke="Red"></local:Rechteck>
        <local:Quadrat X1="160" Y1="11" L="33" Stroke="Green"></local:Quadrat>
        <local:Kreis X1="250" Y1="50" R="25" Stroke="Purple"></local:Kreis>
        <local:Elipse X1="330" Y1="44" R1="35" R2="22" Stroke="Orange"></local:Elipse>
        <local:Polygon X1="250" Y1="50" E="5" R="15" Stroke="Violet"></local:Polygon>
        <local:Dreieck X1="400" Y1="50" R="15" Stroke="Gold"></local:Dreieck>
        <local:Sechseck X1="450" Y1="50" R="15" Stroke="LightSkyBlue"></local:Sechseck>
        <local:Parallelogram X1="500" Y1="33" L="50" B="22" W="45" Stroke="Brown"></local:Parallelogram>
        <local:Rhombus X1="560" Y1="33" L="50" W="36" Stroke="SandyBrown"></local:Rhombus>
        <local:Trapez X1="666" Y1="33" X2="750" Y2="66" L1="100" L2="50"  Stroke="LightGreen"></local:Trapez>
        <local:Stern X1="66" Y1="111" E="5" R1="33" R2="10" Stroke="DarkBlue"></local:Stern>
        <local:Spirale X1="200" Y1="200" EndRadius="200" GesamtWinkel="30" StepsN="400" Stroke="DarkBlue"></local:Spirale>
    </Canvas>   
</Window>
