<Window x:Class="WPF_Media_Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Player"
        Background="{StaticResource BgBrush}"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        MouseMove="Window_MouseMove">

    <Grid>

        <!-- VIDEO -->
        <MediaElement x:Name="video"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      Volume="{Binding Volume}"/>

        <!-- OVERLAY -->
        <Border x:Name="ControlOverlay"
                VerticalAlignment="Bottom"
                Margin="20"
                Background="#CCFFFFFF"
                CornerRadius="10"
                Height="80"
                Opacity="0.95">

            <DockPanel LastChildFill="False">

                <!-- TIMELINE -->
                <ProgressBar x:Name="progressBar"
                             Height="5"
                             DockPanel.Dock="Top"
                             Minimum="0"
                             Maximum="{Binding Duration}"
                             Value="{Binding Progress}"
                             Style="{StaticResource proBar}"
                             Margin="10,0,10,6"
                             MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown"/>

                <!-- CONTROLS -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Play / Pause -->
                    <Button Style="{StaticResource btnStyle}" Click="PlayButton_Click" Margin="6,0">
                        <Image x:Name="img_play" Source="pack://application:,,,/resources/play-button.png" Width="24"/>
                    </Button>

                    <!-- Stop -->
                    <Button Style="{StaticResource btnStyle}" Click="StopButton_Click" Margin="6,0">
                        <Image Source="pack://application:,,,/resources/stop-button.png" Width="24"/>
                    </Button>

                    <!-- Volume Slider -->
                    <Slider Width="120" Minimum="0" Maximum="1" SmallChange="0.01" Value="{Binding Volume, Mode=TwoWay}" Margin="6,0"/>

                    <!-- Mute -->
                    <Button Style="{StaticResource btnStyle}" Click="MuteButton_Click" Margin="6,0">
                        <Image Source="pack://application:,,,/resources/volume-mute.png" Width="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MENU BAR -->
        <Menu VerticalAlignment="Top" Background="{StaticResource PanelBrush}" Opacity="0.95">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="OpenFile_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

    </Grid>
</Window>
