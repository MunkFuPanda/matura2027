<Application x:Class="WPF_Media_Player.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPF_Media_Player"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Converter für Playlist -->
        <local:FilenameConverter x:Key="FilenameConverter"/>

        <!-- Buttons Style -->
        <Style x:Key="btnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6366F1"/>
                    <Setter Property="BorderBrush" Value="#FF6366F1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF4F46E5"/>
                    <Setter Property="BorderBrush" Value="#FF4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ProgressBar Style -->
        <Style TargetType="ProgressBar" x:Key="proBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Foreground" Value="#FF10B981"/>
            <Setter Property="Background" Value="#FFD1FAE5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Theme Colors -->
        <SolidColorBrush x:Key="BgBrush" Color="#FFF8F9FA"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6366F1"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FF10B981"/>
    </Application.Resources>
</Application>
