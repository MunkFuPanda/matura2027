<Window x:Class="Achterbahn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Achterbahn"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="397*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120*"/>
            <ColumnDefinition Width="96*"/>
            <ColumnDefinition Width="91*"/>
            <ColumnDefinition Width="101*"/>
            <ColumnDefinition Width="104*"/>
            <ColumnDefinition Width="95*"/>
            <ColumnDefinition Width="97*"/>
            <ColumnDefinition Width="96*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Warteschlange"></Label>
        <Label Grid.Row="0" Grid.Column="1" Content="spazieren"></Label>
        <Label Grid.Row="0" Grid.Column="2" Content="Achterbahn"></Label>
        <Label x:Name="lb_status_achterbahn" Grid.Row="0" Grid.Column="3" Content="Status"></Label>

        <Label Grid.Row="0" Grid.Column="4" Content="Anzahl Personen:"></Label>
        <TextBox x:Name="tb_count_person" Grid.Row="0" Grid.Column="5"></TextBox>
        <Label Grid.Row="0" Grid.Column="6" Content="Anzahl Plätze:"></Label>
        <TextBox x:Name="tb_count_places" Grid.Row="0" Grid.Column="7"></TextBox>

        <ListBox x:Name="waiting_queue" Grid.Row="1" Grid.Column="0"/>
        <ListBox x:Name="walking_queue" Grid.Row="1" Grid.Column="1"/>
        <ListBox x:Name="roller_coaster_queue" Grid.Row="1" Grid.Column="2"/>

        <Button x:Name="startButton" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="5" Content="Start" Click="startButton_Click"></Button>
    </Grid>
</Window>
