<Window x:Class="Gomoku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gomoku"
        mc:Ignorable="d"
        Title="Gomoku" Height="650" Width="800" MinHeight="650" MinWidth="800">
    <DockPanel>
        <Label Content="Size" DockPanel.Dock="Top"></Label>
        <ComboBox x:Name="cb_selsize" DockPanel.Dock="Top"></ComboBox>
        
        <Label Content="Modus" DockPanel.Dock="Top"></Label>
        <ComboBox x:Name="cb_selcontroller" DockPanel.Dock="Top"></ComboBox>
        
        <Label x:Name="lb_current_player" DockPanel.Dock="Top" Content="Game not started"></Label>
        <Button x:Name="startButton" Click="startButton_Click" Content="Start" DockPanel.Dock="Top"></Button>
        
        <ListView x:Name="lv_playarea" DockPanel.Dock="Top" MouseDoubleClick="lv_playarea_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid></UniformGrid>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Colour}"></Label>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
