<Window x:Class="PixelDraw_2024.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelDraw_2024"
        mc:Ignorable="d"
        Title="Drawing" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed"></CommandBinding>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" CanExecute="Save_CanExecute"></CommandBinding>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" CanExecute="Save_CanExecute"></CommandBinding>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute"></CommandBinding>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute"></CommandBinding>
    </Window.CommandBindings>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5px">
            <Button Content="Draw" Padding="5px" Name="button1" VerticalAlignment="Top" Click="button1_Click" />
            <ComboBox x:Name="cb_selection" SelectedIndex="0">
                <ComboBoxItem Content="Line"></ComboBoxItem>
                <ComboBoxItem Content="Circle"></ComboBoxItem>
                <ComboBoxItem Content="Curves"></ComboBoxItem>
            </ComboBox>
            <Button x:Name="undoButton" Content="&lt;- Undo" Command="ApplicationCommands.Undo"></Button>
            <Button x:Name="redoButton" Content="Redo - &gt;" Command="ApplicationCommands.Redo"></Button>

            <Button x:Name="openButton" Command="ApplicationCommands.Open" Content="Open"></Button>
            <Button x:Name="saveButton" Command="ApplicationCommands.Save" Content="Save"></Button>
            <Button x:Name="saveasButton" Command="ApplicationCommands.SaveAs" Content="Save As"></Button>

        </StackPanel>
        <Image Name="drawing" Stretch="Uniform" MouseLeftButtonDown="drawing_MouseLeftButtonDown" MouseRightButtonDown="drawing_MouseRightButtonDown"/>

    </DockPanel>
</Window>
