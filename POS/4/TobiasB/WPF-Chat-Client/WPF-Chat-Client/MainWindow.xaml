<Window x:Class="WPF_Chat_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Chat_Client"
        mc:Ignorable="d"
        Title="WPF-Chat-Client" Height="450" Width="800">
    <StackPanel>
        <Label Content="Client"></Label>
        <Label x:Name="debuglabel"></Label>

        <Button x:Name="loginButton" Content="Login" Click="loginButton_Click"></Button>
        <Button x:Name="registrationButton" Content="Registration" Click="registrationButton_Click"></Button>

        <ComboBox x:Name="ChatUser" SelectionChanged="ChatUser_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Name}"></Label>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <ListBox x:Name="lb_messages">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Content}"></Label>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBox x:Name="input"></TextBox>
        <Button Content="Send" Click="Send_Click"></Button>

        <!--<TabControl>
            <TabItem Header="Tab1">
                <Label Content="Tab 1"></Label>
            </TabItem>
            <TabItem Header="Tab2">
                <Label Content="Tab 2"></Label>
            </TabItem>
        </TabControl> -->
    </StackPanel>
</Window>
