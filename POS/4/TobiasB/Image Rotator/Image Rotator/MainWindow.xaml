<Window x:Class="Image_Rotator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Image_Rotator"
        mc:Ignorable="d"
        Title="Image Rotator" Height="450" Width="800">
    <StackPanel>
        <Label Content="Ordnerpfad"></Label>
        <TextBox x:Name="tb_path"></TextBox>
        <Button x:Name="open_folder_button" Content="Ordner öffnen" Click="open_folder_button_Click"></Button>
        <Label Content="Spiegelung"></Label>
        <ComboBox x:Name="cb_spiegelung"></ComboBox>
        <Label Content="Rotation"></Label>
        <ComboBox x:Name="cb_rotation"></ComboBox>
        <Label Content="JPEG Qualität"></Label>
        <Slider x:Name="jpeg_quality" Minimum="30" Maximum="100" Value="30" ToolTipService.ToolTip="{Binding Path=Value, ElementName=jpeg_quality}" TickFrequency="1" IsSnapToTickEnabled="True"></Slider>
        <Label Content="Fortschritt"></Label>
        <ProgressBar x:Name="progressbar" Minimum="0"  Value="0" Height="20"></ProgressBar>
        <Button x:Name="start_button" Content="Start" Click="start_button_Click"></Button>
    </StackPanel>
</Window>
