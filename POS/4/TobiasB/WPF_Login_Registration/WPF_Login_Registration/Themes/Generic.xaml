<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPF_Login_Registration">
    <!--Login-->
    <Style TargetType="{x:Type local:Login}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Login}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel>
                            <Label Content="Login"></Label>

                            <Button x:Name="PART_TO_REGISTRATION" Content="Registration" Cursor="Hand" Margin="300 0 0 0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock TextDecorations="Underline">
                                    <ContentPresenter />
                                        </TextBlock>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="Navy" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="Foreground" Value="Red" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>


                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20*"/>
                                    <ColumnDefinition Width="80*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                </Grid.RowDefinitions>

                                
                                
                                <Label x:Name="PART_L_EMAIL" Content="" Grid.Column="0" Grid.Row="0"></Label>
                                <TextBox x:Name="PART_TB_EMAIL" Grid.Column="1" Grid.Row="0"></TextBox>

                                <Label Content="Password" Grid.Column="0" Grid.Row="1"></Label>
                                <PasswordBox x:Name="PART_TB_PASSWORD" Grid.Column="1" Grid.Row="1"></PasswordBox>

                                <Button x:Name="PART_LOGIN_BUTTON" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Height="25" Width="50" Content="Login"></Button>

                                <TextBlock x:Name="PART_TB_ERROR" Text="" Visibility="Hidden" Background="DarkRed" Foreground="DarkGray" Grid.ColumnSpan="2" Grid.Row="3"></TextBlock>
                            </Grid>
                        </StackPanel>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Registration-->
    <Style TargetType="{x:Type local:Registration}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Registration}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel>
                            <Label Content="Registration"></Label>

                            <Button x:Name="PART_TO_LOGIN" Content="Login" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock TextDecorations="Underline">
                                    <ContentPresenter />
                                        </TextBlock>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="Navy" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter Property="Foreground" Value="Red" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>


                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25*"/>
                                    <ColumnDefinition Width="80*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                    <RowDefinition Height="30*"/>
                                </Grid.RowDefinitions>
                                <Label Content="First Name:" Grid.Column="0" Grid.Row="0"></Label>
                                <TextBox x:Name="PART_TB_FIRST_NAME" Grid.Column="1" Grid.Row="0"></TextBox>

                                <Label Content="Last Name:" Grid.Column="0" Grid.Row="1"></Label>
                                <TextBox x:Name="PART_TB_LAST_NAME" Grid.Column="1" Grid.Row="1"></TextBox>

                                <Label Content="Email:" Grid.Column="0" Grid.Row="2"></Label>
                                <TextBox x:Name="PART_TB_EMAIL" Grid.Column="1" Grid.Row="2"></TextBox>

                                <Label Content="Password:" Grid.Column="0" Grid.Row="3"></Label>
                                <TextBox x:Name="PART_TB_PASSWORD" Grid.Column="1" Grid.Row="3"></TextBox>

                                <Label Content="Confirm Password:" Grid.Column="0" Grid.Row="4"></Label>
                                <TextBox x:Name="PART_TB_CONFIRM_PASSWORD" Grid.Column="1" Grid.Row="4"></TextBox>

                                <Label Content="Address:" Grid.Column="0" Grid.Row="5"></Label>
                                <TextBox x:Name="PART_TB_ADDRESS" Grid.Column="1" Grid.Row="5"></TextBox>

                                <Grid Grid.Column="1" Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="33*"/>
                                        <ColumnDefinition Width="33*"/>
                                        <ColumnDefinition Width="33*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30*"/>
                                    </Grid.RowDefinitions>

                                    <Button x:Name="PART_SUBMIT_BUTTON" Content="Submit" Grid.Column="0" Grid.Row="0"></Button>
                                    <Button x:Name="PART_RESET_BUTTON" Content="Reset" Grid.Column="1" Grid.Row="0"></Button>
                                    <Button x:Name="PART_CANCEL_BUTTON" Content="Cancel" Grid.Column="2" Grid.Row="0"></Button>
                                    
                                </Grid>

                            </Grid>

                            
                            
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>