<Window x:Class="Drei_Raucher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Drei_Raucher"
        mc:Ignorable="d"
        Title="Drei Raucher" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="121*"/>
            <RowDefinition Height="121*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Raucher"></Label>
        <Label Grid.Row="1" Grid.Column="0" Content="Raucher A"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Raucher B"></Label>
        <Label Grid.Row="3" Grid.Column="0" Content="Raucher C"></Label>

        <Label Grid.Row="0" Grid.Column="1" Content="Rauchzeit (ms)"></Label>
        <TextBox x:Name="tb_raucher_1" Grid.Row="1" Grid.Column="1" Text="10"/>
        <TextBox x:Name="tb_raucher_2" Grid.Row="2" Grid.Column="1" Text="20"></TextBox>
        <TextBox x:Name="tb_raucher_3" Grid.Row="3" Grid.Column="1" Text="30"></TextBox>

        <Label Grid.Row="0" Grid.Column="2" Content="Status"></Label>
        <Label x:Name="lb_status_1" Grid.Row="1" Grid.Column="2" Content="Status"/>
        <Label x:Name="lb_status_2" Grid.Row="2" Grid.Column="2" Content="Status"></Label>
        <Label x:Name="lb_status_3" Grid.Row="3" Grid.Column="2" Content="Status"></Label>

        <Label Grid.Row="0" Grid.Column="3" Content="Vorrat"></Label>
        <Label Grid.Row="1" Grid.Column="3" Content="Tabak"/>
        <Label Grid.Row="2" Grid.Column="3" Content="Zigarettenpapier"></Label>
        <Label Grid.Row="3" Grid.Column="3" Content="Streichholz"></Label>

        <Label Grid.Row="0" Grid.Column="4" Content="Benötigt"></Label>
        <Label x:Name="lb_need_1" Grid.Row="1" Grid.Column="4" Content="Benötigt"/>
        <Label x:Name="lb_need_2" Grid.Row="2" Grid.Column="4" Content="Benötigt"></Label>
        <Label x:Name="lb_need_3" Grid.Row="3" Grid.Column="4" Content="Benötigt"></Label>

        <Label Grid.Row="4" Grid.Column="2" Content="Tisch" VerticalAlignment="Center" HorizontalAlignment="Center"></Label>
        <Label x:Name="lb_table_1" Grid.Row="5" Grid.Column="1" Content="Tisch" VerticalAlignment="Center" HorizontalAlignment="Center"></Label>
        <Label x:Name="lb_table_2" Grid.Row="5" Grid.Column="3" Content="Tisch" VerticalAlignment="Center" HorizontalAlignment="Center"></Label>
        <StackPanel Grid.Row="5" Grid.Column="2">
            <Button x:Name="startButton"  Content="Start" VerticalAlignment="Center" HorizontalAlignment="Center" Click="startButton_Click"></Button>
            <Button x:Name="stopButton"  Content="Stop" VerticalAlignment="Center" HorizontalAlignment="Center" Click="stopButton_Click"></Button>
        </StackPanel>
        


    </Grid>
</Window>
