<Window x:Class="Waldwunder_Verwaltung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Waldwunder_Verwaltung"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" SizeChanged="window_SizeChanged">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Datei">
                <MenuItem Header="Neues Waldwunder" Click="MenuItem_Click"></MenuItem>
                <MenuItem Header="Anzeigen" Click="MenuItem_Click_4"></MenuItem>
            </MenuItem>
            <MenuItem Header="Suche">
                <MenuItem Header="Stichwort" Click="MenuItem_Click_1"></MenuItem>
                <MenuItem Header="Art" Click="MenuItem_Click_2"></MenuItem>
                <MenuItem Header="Ort" Click="MenuItem_Click_3"></MenuItem>
            </MenuItem>
        </Menu>

        <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="2">
            <TextBox x:Name="searchBox1"></TextBox>
            <TextBox x:Name="searchBox2"></TextBox>
        </UniformGrid>
        
        
        
        <ListBox x:Name="listwaldwunder" DockPanel.Dock="Right" MaxWidth="100">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <UniformGrid Rows="1" Columns="2">
                        <TextBlock Text="{Binding Name}"></TextBlock>
                        <TextBlock Text="{Binding Description}"></TextBlock>
                    </UniformGrid>
                    
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Canvas x:Name="canvas_map" DockPanel.Dock="Top"></Canvas>
    </DockPanel>
</Window>
