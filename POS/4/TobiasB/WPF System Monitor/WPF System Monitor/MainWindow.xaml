<Window x:Class="WPF_System_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_System_Monitor"
        xmlns:WPF_Indicator="clr-namespace:WPF_Indicator;assembly=WPF_Indicator"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Toggle visibility" Click="MenuItem_Click_Hidden_Visible"/>
            <MenuItem Header="Close" Click="MenuItem_Click_Close"/>
        </ContextMenu>
    </Window.Resources>
    <StackPanel>
        <WPF_Indicator:Indicator x:Name="Indicator" HorizontalAlignment="Center" VerticalAlignment="Center" Maximum="100" Minimum="0" Value="0" MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Content="CPU %" Background="Gray"></Label>

        <tb:TaskbarIcon x:Name="SystemTrayIcon"
                        Visibility="Visible"
                        IconSource="/system_tray_icon.ico"
                        ContextMenu="{StaticResource TrayMenu}"
                        MenuActivation="LeftOrRightClick">
        </tb:TaskbarIcon>

    </StackPanel>
</Window>
