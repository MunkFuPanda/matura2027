<Window x:Class="WPF_WordPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_WordPad"
        mc:Ignorable="d"
        Title="WPF WordPad" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"
                        Executed="New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Save_Executed"
                        CanExecute="Save_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.SaveAs"
                        Executed="SaveAs_Executed"
                        CanExecute="Save_CanExecute"/>
    </Window.CommandBindings>
    <DockPanel>

        <!-- Mit Fluent.Ribbon probieren -->
        <Ribbon DockPanel.Dock="Top" x:Name="rb_ribbon">

            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu>
                    <MenuItem Command="ApplicationCommands.New"></MenuItem>
                    <MenuItem Command="ApplicationCommands.Open"></MenuItem>
                    <MenuItem Command="ApplicationCommands.Save"></MenuItem>
                    <MenuItem Command="ApplicationCommands.SaveAs"></MenuItem>

                    <!--Anzeige von Dateitext im ApplicationMenu Button-->
                    <RibbonApplicationMenu.SmallImageSource>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,10,10"></RectangleGeometry>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <VisualBrush Stretch="Uniform">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Datei" FontSize="16" Foreground="White" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </RibbonApplicationMenu.SmallImageSource>

                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>

            <RibbonTab Header="Start">
                <RibbonGroup Header="Schrift">
                    <RibbonButton Name="Size" Label="Size" Click="Size_Click"></RibbonButton>
                    <RibbonToggleButton Name="Bold" Label="Bold" CommandTarget="{Binding ElementName=rtb_textbox}" Command="EditingCommands.ToggleBold"></RibbonToggleButton>
                    <RibbonToggleButton Name="Italic" Label="Italic" CommandTarget="{Binding ElementName=rtb_textbox}" Command="EditingCommands.ToggleItalic"></RibbonToggleButton>
                    <RibbonToggleButton Name="Underline" Label="Underline" CommandTarget="{Binding ElementName=rtb_textbox}" Command="EditingCommands.ToggleUnderline"></RibbonToggleButton>
                </RibbonGroup>

                <RibbonGroup Header="Cut/Copy/Paste">
                    <RibbonButton Name="Cut" Label="Cut" CommandTarget="{Binding ElementName=rtb_textbox}" Command="ApplicationCommands.Cut"></RibbonButton>
                    <RibbonButton Name="Copy" Label="Copy" CommandTarget="{Binding ElementName=rtb_textbox}" Command="ApplicationCommands.Copy"></RibbonButton>
                    <RibbonButton Name="Paste" Label="Paste" CommandTarget="{Binding ElementName=rtb_textbox}" Command="ApplicationCommands.Paste"></RibbonButton>
                </RibbonGroup>

            </RibbonTab>
        </Ribbon>
        <RichTextBox DockPanel.Dock="Top" x:Name="rtb_textbox"></RichTextBox>
    </DockPanel>
</Window>