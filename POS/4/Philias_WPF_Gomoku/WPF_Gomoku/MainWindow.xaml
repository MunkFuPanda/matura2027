<Window x:Class="WPF_Gomoku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Gomoku"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800">

    <Window.Resources>
        <DataTemplate x:Key="CellTemplate">
            <Border BorderBrush="Gray" BorderThickness="0.5" Background="BurlyWood"
                MouseLeftButtonDown="Cell_MouseLeftButtonDown" Cursor="Hand">
                <TextBlock Text="{Binding Charater}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="6"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Top" FontSize="16"/>
        <Viewbox Stretch="Uniform" Margin="10" Width="600" Height="600">
            <ItemsControl x:Name="BoardGrid" ItemTemplate="{StaticResource CellTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="Height" Value="10"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="BoardGrid1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Viewbox>
    </Grid>
</Window>
