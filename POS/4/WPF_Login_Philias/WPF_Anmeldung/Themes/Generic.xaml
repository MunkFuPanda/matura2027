<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPF_Anmeldung">
    <Style TargetType="{x:Type local:LoginControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LoginControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock Text="Login:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" FontSize="24"/>

                            <Button x:Name="PART_SwitchToRegistration" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,22,0" FontSize="16" Background="Transparent" Foreground="Blue" BorderThickness="0">
                                <Button.Content>
                                    <TextBlock>
        <Underline>Registration</Underline>
                                    </TextBlock>
                                </Button.Content>
                            </Button>

                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,60,0,0" FontSize="11" FontStyle="Italic">
            Note: Please login here to view the features of this site. If you are new on this site then<LineBreak />
            please click on the Register-Button
                            </TextBlock>

                            <TextBlock Text="Email:" HorizontalAlignment="Left" Margin="100,118,0,0" VerticalAlignment="Top" FontSize="16"/>
                            <TextBox x:Name="PART_UserInput" HorizontalAlignment="Left" Height="30" Margin="150,118,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" FontSize="16"/>

                            <TextBlock Text="Password:" HorizontalAlignment="Left" Margin="70,171,0,0" VerticalAlignment="Top" FontSize="16"/>
                            <PasswordBox x:Name="PART_Password" HorizontalAlignment="Left" Height="30" Margin="150,171,0,0" VerticalAlignment="Top" Width="200" FontSize="16"/>

                            <Button x:Name="PART_LoginButton" Content="Login" HorizontalAlignment="Left" Margin="150,230,0,0" VerticalAlignment="Top" Width="100" Height="30" FontSize="16"/>

                            <TextBlock x:Name="PART_Error" HorizontalAlignment="Left" Margin="150,288,0,0" VerticalAlignment="Top" FontSize="14" Foreground="Red" Text="Login Fehlgeschlagen!" Visibility="Hidden"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:RegistrationControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RegistrationControl}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock Text="Registration:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" FontSize="24"/>

                            <Button x:Name="PART_switchToLogin" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,22,0" FontSize="16" Background="Transparent" Foreground="Blue" BorderThickness="0">
                                <Button.Content>
                                    <TextBlock>
<Underline>Login</Underline>
                                    </TextBlock>
                                </Button.Content>
                            </Button>

                            <TextBlock Text="First Name:" HorizontalAlignment="Left" Margin="69,63,0,0" VerticalAlignment="Top" FontSize="13"/>
                            <TextBox x:Name="PART_VNAME" HorizontalAlignment="Left" Height="20" Margin="150,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" FontSize="13"/>

                            <TextBlock Text="Last Name:" HorizontalAlignment="Left" Margin="69,97,0,0" VerticalAlignment="Top" FontSize="13" RenderTransformOrigin="0.471,-0.308"/>
                            <TextBox x:Name="PART_NNAME" HorizontalAlignment="Left" Height="20" Margin="150,96,0,0" VerticalAlignment="Top" Width="200" FontSize="13"/>

                            <TextBlock Text="Email:" HorizontalAlignment="Left" Margin="69,130,0,0" VerticalAlignment="Top" FontSize="13" RenderTransformOrigin="0.471,-0.308"/>
                            <TextBox x:Name="PART_EMAIL" HorizontalAlignment="Left" Height="20" Margin="150,129,0,0" VerticalAlignment="Top" Width="200" FontSize="13"/>

                            <TextBlock Text="Password:" HorizontalAlignment="Left" Margin="69,168,0,0" VerticalAlignment="Top" FontSize="13" RenderTransformOrigin="0.471,-0.308"/>
                            <PasswordBox x:Name="PART_PASSWORD" HorizontalAlignment="Left" Height="20" Margin="150,167,0,0" VerticalAlignment="Top" Width="200" FontSize="13"/>

                            <TextBlock Text="Confirm Password:" HorizontalAlignment="Left" Margin="33,202,0,0" VerticalAlignment="Top" FontSize="13" RenderTransformOrigin="0.471,-0.308"/>
                            <PasswordBox x:Name="PART_CPASSWORD" HorizontalAlignment="Left" Height="20" Margin="150,202,0,0" VerticalAlignment="Top" Width="200" FontSize="13"/>

                            <TextBlock Text="Address:" HorizontalAlignment="Left" Margin="69,237,0,0" VerticalAlignment="Top" FontSize="13" RenderTransformOrigin="0.471,-0.308"/>
                            <TextBox x:Name="PART_ADDRESS" HorizontalAlignment="Left" Height="20" Margin="150,236,0,0" VerticalAlignment="Top" Width="200" FontSize="13"/>

                            <Button x:Name="PART_SUBMIT" Content="Submit" HorizontalAlignment="Left" Margin="150,275,0,0" VerticalAlignment="Top" Width="80" Height="20" FontSize="11"/>
                            <Button x:Name="PART_RESET" Content="Reset" HorizontalAlignment="Left" Margin="250,275,0,0" VerticalAlignment="Top" Width="80" Height="20" FontSize="11"/>
                            <Button x:Name="PART_CANCEL" Content="Cancel" HorizontalAlignment="Left" Margin="352,275,0,0" VerticalAlignment="Top" Width="80" Height="20" FontSize="11"/>

                            <TextBlock x:Name="PART_Error" HorizontalAlignment="Left" Margin="150,305,0,0" VerticalAlignment="Top" FontSize="14" Foreground="Red" Text="Login Fehlgeschlagen!" Visibility="Hidden"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
