<Window x:Class="Test_Anmeldung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test_Anmeldung"
        xmlns:controls="clr-namespace:WPF_Anmeldung;assembly=WPF_Anmeldung"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <Grid>
        <controls:LoginControl x:Name="loginControl" Visibility="Visible" LoginRequested="LoginControl_LoginRequested" LoginWithEmail="True" SwitchtoRegistration="loginControl_SwitchtoRegistration"/>
        <Separator RenderTransformOrigin="0.5,0.291" Margin="0,292,0,347"/>
        <controls:RegistrationControl x:Name="registrationControl" Visibility="Hidden" Register="registrationControl_Register" SwitchToLogin="registrationControl_SwitchToLogin" Cancel="registrationControl_Cancel"/>
    </Grid>
</Window>
