<Window x:Class="IndicatorTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndicatorTest"
        xmlns:indicator="clr-namespace:Indicator;assembly=Indicator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <indicator:CustomControl1 x:Name="indicatorControl" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="300"
                                   MinimumValue="0" MaximumValue="100" CurrentValue="50"/>
    </Grid>
</Window>
