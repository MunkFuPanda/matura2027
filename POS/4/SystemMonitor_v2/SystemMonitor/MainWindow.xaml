<Window x:Class="SystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemMonitor"
        xmlns:indicator="clr-namespace:Indicator;assembly=Indicator"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        >
    <Window.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                    Visibility="Visible"
                    ToolTipText="System Monitor"
                    IconSource="/67.ico">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Toggle Visibility" Click="ToggleVisibility_Click"/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <TextBlock Text="CPU %" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,33" Background="LightGray" Width="300" TextAlignment="Center"/>
        <indicator:CustomControl1
        x:Name="indicator"
        Width="400"
        Height="400"
        CurrentValue="0"
        MinimumValue="0"
        MaximumValue="100"/>
    </Grid>
</Window>
