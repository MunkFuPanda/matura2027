<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPF_Rating">
    <Style TargetType="{x:Type local:Rating}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Rating}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Rating Control Test" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

                                <TextBlock x:Name="PART_RatingTextBlock" Text="Default Rating Control:" FontSize="16" Margin="10,20,10,5" HorizontalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,33,0,0">
                                    <Image x:Name="PART_Star1" Source="pack://application:,,,/WPF_Rating;component/Ressourcen/star_unfilled.png" Width="40" Height="40" HorizontalAlignment="Center"/>
                                    <Image x:Name="PART_Star2" Source="pack://application:,,,/WPF_Rating;component/Ressourcen/star_unfilled.png" Width="40" Height="40" HorizontalAlignment="Center"/>
                                    <Image x:Name="PART_Star3" Source="pack://application:,,,/WPF_Rating;component/Ressourcen/star_unfilled.png" Width="40" Height="40" HorizontalAlignment="Center"/>
                                    <Image x:Name="PART_Star4" Source="pack://application:,,,/WPF_Rating;component/Ressourcen/star_unfilled.png" Width="40" Height="40" HorizontalAlignment="Center"/>
                                    <Image x:Name="PART_Star5" Source="pack://application:,,,/WPF_Rating;component/Ressourcen/star_unfilled.png" Width="40" Height="40" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Slider x:Name="PART_RatingSlider" Minimum="0" Maximum="5" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                                <Button x:Name="PART_SubmitButton" Content="Submit Rating" Width="120" Height="30" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
