<Window x:Class="WPF_Chat_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Server" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtPort" Text="5000" Width="80" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnStart" Content="Start" Click="BtnStart_Click" Width="80" Margin="0,0,5,0"/>
            <Button x:Name="BtnStop" Content="Stop" Click="BtnStop_Click" Width="80" IsEnabled="False"/>
        </StackPanel>

        <ListBox x:Name="LstLog" Grid.Row="1" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
