<Window x:Class="WPF_Chat_Client.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Chat_Client"
        mc:Ignorable="d"
        Title="Login" Height="250" Width="250">
    <Grid>
        <TextBlock Text="Enter your username:" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,29,0,0" FontSize="16"/>
        <TextBox Name="UsernameBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,68,0,0" Width="200" FontSize="14"/>
        <TextBlock Text="Enter your password:" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" FontSize="16"/>
        <PasswordBox Name="PasswordBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,133,0,0" Width="200" FontSize="14"/>
        <Button Name="LoginButton" Content="Login" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,176,0,0" Width="100" Background="White" Click="BtnLogin_Click"/>
    </Grid>
</Window>
