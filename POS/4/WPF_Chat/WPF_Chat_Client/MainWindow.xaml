<Window x:Class="WPF_Chat_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Chat_Client"
        mc:Ignorable="d"
        Title="Client" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- Tabs pro Room mit Nachrichten -->
        <TabControl Name="ChatTabs" Margin="10"
                    ItemsSource="{Binding Rooms}">
            <!-- Tab-Header: Room-Name -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="13" Padding="5,2" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <!-- Tab-Content: Nachrichten-Liste -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ListBox ItemsSource="{Binding Messages}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1"
                                        Padding="5" Margin="2">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontWeight="Bold" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                       Foreground="Gray" HorizontalAlignment="Right"
                                                       DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Eingabezeile -->
        <WrapPanel Grid.Row="1" VerticalAlignment="Bottom" Height="50">
            <Border BorderBrush="Gray" BorderThickness="0.5" Margin="10" Width="650">
                <TextBox Name="InputBox" Margin="5" FontSize="14"
                         KeyDown="InputBox_KeyDown" />
            </Border>
            <Button Name="SendButton" Content="Send" Margin="20,0,0,13"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="75" Background="White" Click="BtnSend_Click" />
        </WrapPanel>
    </Grid>

</Window>
