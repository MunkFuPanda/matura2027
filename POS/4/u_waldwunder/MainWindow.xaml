<Window x:Class="u_waldwunder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:u_waldwunder"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="1800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Datei">
                <MenuItem Header="Neues Waldwunder" Click="neuesWaldwunder"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,10,0" >
                <GroupBox Header="1. Suchen" Margin="0,0,0,10" DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBox x:Name="SearchTextBox" Margin="0,0,0,5" ToolTip="Suchbegriff eingeben" TextChanged="textChangedTextbox"/>
                        <ComboBox x:Name="SearchComboBox" SelectionChanged="selectionChangedCombobox"/>
                        <Button x:Name="SearchButton" Content="Suchen" Margin="0,10,0,5" Click="searchButtonClick" IsEnabled="False"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. Anzeigen" Margin="0,0,0,10" DockPanel.Dock="Bottom">
                    <Button x:Name="ShowDetailsButton" Content="Details anzeigen" Margin="0,10,0,5" Click="showDetailsButtonClick" IsEnabled="False"/>
                </GroupBox>
                
                <Separator DockPanel.Dock="Bottom" Margin="0,10,0,10" />
            </DockPanel>

            <Grid Grid.Column="1" x:Name="Map">
                <Image Source="pack://application:,,,/ressourcen/karte.png" Stretch="Uniform" Margin="10"/>
                <Canvas x:Name="MapCanvas"/>
            </Grid>

            <GroupBox Grid.Column="2" Header="Liste" Margin="0,0,5,0">
                <ListBox x:Name="WaldwunderBox" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="ChosenWaldwunderChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Padding="5" Margin="0,0,0,5">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <Separator Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Description}" Margin="0,0,5,0" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
