<Window x:Class="u_waldwunder.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:u_waldwunder"
        mc:Ignorable="d"
        Title="RegisterDialog" Height="700" Width="500">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Name" Margin="0,0,0,10" Grid.Row="0">
            <TextBox x:Name="NameTextBox" Margin="0,0,0,5" FontSize="16" FontWeight="Bold"/>
        </GroupBox>
        <GroupBox Header="Beschreibung" Margin="0,0,0,10" Grid.Row="1">
            <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,5" FontSize="12" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Bundesland" Margin="0,0,0,10" Grid.Row="2">
            <TextBox x:Name="ProvinzTextBox" Margin="0,0,0,5" FontSize="12" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Art" Margin="0,0,0,10" Grid.Row="3">
            <TextBox x:Name="TypeTextBox" Margin="0,0,0,5" FontSize="12" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Latitude" Margin="0,0,0,10" Grid.Row="4">
            <TextBox x:Name="LatitudeTextBox" Margin="0,0,0,5" FontSize="12" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Longitude" Margin="0,0,0,10" Grid.Row="5">
            <TextBox x:Name="LongitudeTextBox" Margin="0,0,0,5" FontSize="12" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Bewertung" Margin="0,0,0,10" Grid.Row="6">
            <TextBox x:Name="RatingTextBox" Margin="0,0,0,5" FontSize="12" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Bilder" Margin="0,0,0,10" Grid.Row="7">
            <StackPanel>
                <Button x:Name="AddImageButton" Content="Bild hinzufügen" Margin="0,0,0,10" Click="addImageButtonClick"></Button>
                <TextBlock Text="Klicken Sie auf ein Bild, um es zu entfernen." FontSize="11" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <ListBox x:Name="ImageListBox" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Padding="5" Margin="0,0,0,5">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Name}" Margin="0,0,5,0" MouseLeftButtonDown="removePicture"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Abbrechen" Margin="0,0,10,0" Click="cancelButtonClick"/>
                <Button x:Name="RegisterButton" Content="Registrieren" Click="registerButtonClick"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
