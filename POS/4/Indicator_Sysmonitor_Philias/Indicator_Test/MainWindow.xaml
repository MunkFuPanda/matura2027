<Window x:Class="Indicator_Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Indicator_Test"
        xmlns:indicator="clr-namespace:WPF_Indicator;assembly=WPF_Indicator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <indicator:CustomControl1
        x:Name="indicator"
        Width="400"
        Height="400"
        CurrentValue="{Binding Value, ElementName=currvalueSlider}"
        MinimumValue="{Binding Value, ElementName=minvalueSlider}"
        MaximumValue="{Binding Value, ElementName=maxvalueSlider}"
        Margin="343,17,57,17"/>

        <Slider x:Name="currvalueSlider"
        Width="300"
        Minimum="0"
        Maximum="100" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>

        <Slider x:Name="minvalueSlider"
        Width="300"
        Minimum="0"
        Maximum="100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,127,0,0"/>

        <Slider x:Name="maxvalueSlider"
        Width="300"
        Minimum="1"
        Maximum="100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,287,0,0"/>

    </Grid>
</Window>
