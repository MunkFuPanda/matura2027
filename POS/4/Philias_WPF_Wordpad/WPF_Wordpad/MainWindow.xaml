<Window x:Class="WPF_Wordpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Wordpad"
        
        xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="800">
    <Grid>
        <Ribbon>
            <RibbonTab Header="Home">
                <RibbonGroup Header="Clipboard">
                    <RibbonButton Label="Cut" Name="Cut" CommandTarget="{Binding ElementName=richTextBox1}" Command="ApplicationCommands.Cut"/>
                    <RibbonButton Label="Copy" Name="Copy" CommandTarget="{Binding ElementName=richTextBox1}" Command="ApplicationCommands.Copy"/>
                    <RibbonButton Label="Paste" Name="Paste" CommandTarget="{Binding ElementName=richTextBox1}" Command="ApplicationCommands.Paste"/>
                </RibbonGroup>
                <RibbonGroup Header="Font">
                    <RibbonComboBox Label="Font" />
                    <RibbonComboBox Label="Size" />
                    <RibbonToggleButton Name="Bold" Label="Bold" CommandTarget="{Binding ElementName=richTextBox1}" Command="EditingCommands.ToggleBold"></RibbonToggleButton>
                    <RibbonToggleButton Name="Italic" Label="Italic" CommandTarget="{Binding ElementName=richTextBox1}" Command="EditingCommands.ToggleItalic"></RibbonToggleButton>
                    <RibbonToggleButton Name="Underline" Label="Underline" CommandTarget="{Binding ElementName=richTextBox1}" Command="EditingCommands.ToggleUnderline"></RibbonToggleButton>
                </RibbonGroup>
                <RibbonGroup Header="Other Things">
                    <RibbonButton Label="Save" Name="Save" Command="ApplicationCommands.Save"/>
                    <RibbonButton Label="Open" Name="Open" Command="ApplicationCommands.Open"/>
                    <RibbonButton Label="New" Name="New" Command="ApplicationCommands.New"/>
                    <RibbonButton Label="Undo" Name="Undo" Command="ApplicationCommands.Undo"/>
                    <RibbonButton Label="Redo" Name="Redo" Command="ApplicationCommands.Redo"/>
                    <RibbonButton Label="Print" Name="Print" Command="ApplicationCommands.Print"/>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
        <RichTextBox x:Name="richTextBox1" Margin="10,150,10,10" CommandManager.PreviewCanExecute="RichTextBox_CanExecute"/>
    </Grid>

    <Window.CommandBindings>

        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Save_Executed"
                        CanExecute="DocumentNotEmpty"/>

        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Open_Executed"/>

        <CommandBinding Command="ApplicationCommands.New"
                        Executed="New_Executed"
                        CanExecute="DocumentNotEmpty"/>

        <CommandBinding Command="ApplicationCommands.Print"
                        Executed="Print_Executed"
                        CanExecute="DocumentNotEmpty"/>

    </Window.CommandBindings>

</Window>
